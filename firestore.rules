rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // System config - public read for version check, authenticated write
    match /system_config/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // Deployment log - admin only
    match /deployment_log/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // App data - open for read/write (clock auth issue)
    match /app_data/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // Activity logs - authenticated read/write
    match /activity_logs/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // Default - deny all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
